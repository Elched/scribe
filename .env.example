# SCRIBE — Environment Configuration
# Copy this file to `.env` and fill in your values
# IMPORTANT: Never commit `.env` to git — add to .gitignore

# ═══════════════════════════════════════════════════════════════════════════
# 🔐 SECURITY (REQUIRED FOR PRODUCTION)
# ═══════════════════════════════════════════════════════════════════════════

SCRIBE_SECRET=change-me-in-production
ADMIN_PASSWORD=Scribe2026!

# ═══════════════════════════════════════════════════════════════════════════
# 🌐 NETWORK (For LAN access, set SCRIBE_HOST to your server IP)
# ═══════════════════════════════════════════════════════════════════════════

# Leave empty for localhost-only, or set to server IP/hostname for LAN access
SCRIBE_HOST=localhost
CORS_ORIGINS=http://localhost,http://localhost:8000

# ═══════════════════════════════════════════════════════════════════════════
# 🤖 AI CONFIGURATION (optional)
# ═══════════════════════════════════════════════════════════════════════════

SCRIBE_IA_PROVIDER=albert
SCRIBE_IA_KEY=
SCRIBE_IA_MODEL=
SCRIBE_IA_URL=

# ═══════════════════════════════════════════════════════════════════════════
# 💾 DATABASE (optional — use PostgreSQL for production)
# ═══════════════════════════════════════════════════════════════════════════

# DATABASE_URL=postgresql://user:password@db:5432/scribe

# ═══════════════════════════════════════════════════════════════════════════
# 📝 LOGGING
# ═══════════════════════════════════════════════════════════════════════════

LOG_LEVEL=info
