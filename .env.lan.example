# SCRIBE — LAN Deployment Configuration Template
# Copy this to `.env` and update values for your local network deployment

# ═══════════════════════════════════════════════════════════════════════════
# 🌐 NETWORK CONFIGURATION (for LAN access)
# ═══════════════════════════════════════════════════════════════════════════

# Server's IP address or hostname on the LAN
# Examples:
#   SCRIBE_HOST=192.168.1.50          (IP address)
#   SCRIBE_HOST=10.0.0.100             (Another subnet)
#   SCRIBE_HOST=scribe.hospital.local  (DNS hostname — requires DNS setup)
SCRIBE_HOST=192.168.1.50

# CORS Origins — list of allowed URLs for frontend requests
# Add all addresses where users will access SCRIBE from
# Syntax: comma-separated list, no spaces
CORS_ORIGINS=http://192.168.1.50,http://192.168.1.50:80,https://192.168.1.50:443,http://localhost,http://localhost:8000

# ═══════════════════════════════════════════════════════════════════════════
# 🔐 SECURITY (CHANGE THESE FOR PRODUCTION)
# ═══════════════════════════════════════════════════════════════════════════

# JWT Signing Secret — MUST be changed for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRIBE_SECRET=ChangeMe_UseAStrongSecureRandomValue_AtLeast32Characters

# Admin Login Password
# Default demo account: dircrise / Scribe2026!
# Change this before exposing to network
ADMIN_PASSWORD=ChangeThisAdminPass!

# ═══════════════════════════════════════════════════════════════════════════
# 🤖 AI CONFIGURATION (optional)
# ═══════════════════════════════════════════════════════════════════════════

# AI Provider — options: albert, openai, anthropic, gemini, mistral, ollama, openai-compat
SCRIBE_IA_PROVIDER=albert

# AI API Key (only if using external provider)
SCRIBE_IA_KEY=

# AI Model Name
SCRIBE_IA_MODEL=

# AI Base URL (for Ollama, LM Studio, etc.)
SCRIBE_IA_URL=

# ═══════════════════════════════════════════════════════════════════════════
# 💾 DATABASE (optional)
# ═══════════════════════════════════════════════════════════════════════════

# For production: use PostgreSQL instead of SQLite
# Uncomment and set the connection string:
# DATABASE_URL=postgresql://scribe_user:secure_password@db-server:5432/scribe

# Default (SQLite): no configuration needed, data stored in /data/db/scribe.db

# ═══════════════════════════════════════════════════════════════════════════
# 📝 LOGGING
# ═══════════════════════════════════════════════════════════════════════════

# Log level — options: debug, info, warning, error, critical
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
# 🚀 DEPLOYMENT INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════════

# 1. Find your server's IP:
#    Windows:  ipconfig /all
#    Linux:    ip addr show
#    macOS:    ifconfig
#
# 2. Copy this file to `.env`:
#    cp .env.lan.example .env
#
# 3. Edit `.env` with your values (especially SCRIBE_HOST and SCRIBE_SECRET)
#
# 4. Start containers:
#    docker compose pull
#    docker compose up -d
#
# 5. Access from remote computer:
#    http://192.168.1.50  (replace with your SCRIBE_HOST)
#
# 6. Default login:
#    Username: dircrise
#    Password: (use ADMIN_PASSWORD value)
#
# ═══════════════════════════════════════════════════════════════════════════
# ⚠️  PRODUCTION SECURITY NOTES
# ═══════════════════════════════════════════════════════════════════════════
#
# - NEVER use default passwords in production
# - NEVER commit `.env` to version control (it contains secrets)
# - Use HTTPS/TLS with valid certificates (not self-signed)
# - Restrict network access with firewalls
# - Use PostgreSQL instead of SQLite for multi-user production
# - Enable VPN access if connecting from outside LAN
# - Regularly rotate SCRIBE_SECRET
# - Keep system and containers updated with security patches
#
# ═══════════════════════════════════════════════════════════════════════════
